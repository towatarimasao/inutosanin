# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
env*.txt

# vercel
.vercel

# backups
backups/

# スラッグ生成ドライラン・調査用の一時出力（店舗名・住所を含むためコミットしない）
scripts/*.csv

# typescript
*.tsbuildinfo
next-env.d.ts
